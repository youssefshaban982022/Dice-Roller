<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">



    <ImageView
        android:id="@+id/dice_iv"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/dice_1"
        app:layout_constraintStart_toEndOf="@id/two_dice_iv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ImageView

        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/dice_6"
        app:layout_constraintEnd_toStartOf="@id/dice_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:id="@+id/two_dice_iv"
        />

    <Button
        android:id="@+id/roll_btn"
        android:text="roll"
        app:layout_constraintStart_toStartOf="@id/two_dice_iv"
        app:layout_constraintEnd_toEndOf="@id/dice_iv"
        app:layout_constraintTop_toBottomOf="@id/dice_iv"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>